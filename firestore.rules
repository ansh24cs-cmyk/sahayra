rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    // Replace the UID after provisioning. The claim is set only by scripts/provision-admin.mjs.
    function isAdmin() { return signedIn() && request.auth.uid == "REPLACE_WITH_ADMIN_UID" && request.auth.token.admin == true; }

    // LEAST PRIVILEGE: every write in this app happens on the server (Admin SDK, which verifies tokens itself).
    // No browser client, including the owner, may write to Firestore directly.
    match /products/{id}   { allow read: if resource.data.archived == false || isAdmin(); allow write: if false; }
    match /categories/{id} { allow read: if true; allow write: if false; }
    match /banners/{id}    { allow read: if resource.data.published == true || isAdmin(); allow write: if false; }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid; allow write: if false;
      match /addresses/{aid} { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
      match /wishlist/{pid}  { allow read: if signedIn() && request.auth.uid == uid; allow write: if false; }
    }
    match /orders/{oid} { allow read: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; }

    match /coupons/{id}  { allow read: if isAdmin(); allow write: if false; }
    match /settings/{id} { allow read: if isAdmin(); allow write: if false; }
    match /messages/{id} { allow read: if isAdmin(); allow write: if false; }
    match /auditLog/{id} { allow read: if isAdmin(); allow write: if false; } // append-only from the server; not editable from any browser

    match /{doc=**} { allow read, write: if false; } // default deny
  }
}
