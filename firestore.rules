rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && request.auth.uid == "REPLACE_WITH_ADMIN_UID" && request.auth.token.admin == true; }
    match /products/{id} { allow read: if resource.data.archived == false || isAdmin(); allow write: if isAdmin(); }
    match /users/{uid} { allow read, write: if request.auth != null && request.auth.uid == uid; }
    match /orders/{id} { allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; } // written by server only
    match /{doc=**} { allow read, write: if isAdmin(); }
  }
}
