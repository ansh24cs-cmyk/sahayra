rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() { return request.auth != null && request.auth.uid == "REPLACE_WITH_ADMIN_UID" && request.auth.token.admin == true; }
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && request.resource.size > 0 && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin();
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
